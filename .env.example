# Copy to .env and fill in. Never commit the resulting file.

# Provider: "gemini" (real answers) or "mock" (canned answers, no network calls).
PROVIDER=gemini

# Required when PROVIDER=gemini. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model selection. The fallback is used when the primary one is rate limited.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Timeout per attempt, extra attempts on transient 5xx/timeouts, and the budget
# for the whole request including retries and the fallback model.
GEMINI_TIMEOUT_MS=25000
GEMINI_MAX_RETRIES=2
GEMINI_DEADLINE_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_THINKING_LEVEL=low

# HTTP server
PORT=3000
# 127.0.0.1 keeps the dev server off the local network. Use 0.0.0.0 only when
# you deliberately want to open it, for example to test from a phone.
HOST=127.0.0.1
# Enable only when the app runs behind a proxy you control (Vercel sets this for
# you). It decides whether X-Forwarded-For is trusted for rate limiting.
TRUST_PROXY=false
# Comma separated list. Empty means "same origin only".
ALLOWED_ORIGINS=
MAX_BODY_BYTES=32768

# Abuse control
RATE_LIMIT_PER_MIN=12

# Conversation window sent to the model
MAX_MESSAGE_CHARS=1000
MAX_HISTORY_MESSAGES=16

# debug | info | warn | error | silent
LOG_LEVEL=info
